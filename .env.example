# Auth mode:
#   power_automate = enforces SharePoint List + Power Automate OTP (default in production when PA URLs are set)
#   demo           = allows interactive simulated Outlook/Teams OTP preview without Microsoft 365 webhooks
AUTH_MODE=demo

# Required in production (power_automate mode):
# Copy the HTTP POST URLs from your two Power Automate Instant Cloud Flows
PA_SEND_OTP_URL=
PA_VERIFY_OTP_URL=

# Optional shared secret header sent from Vercel API -> Power Automate (recommended!)
PA_SHARED_SECRET=

# Secret key for signing HttpOnly session cookies (generate with: openssl rand -hex 32)
SESSION_SECRET=change-this-to-a-long-random-secret-in-vercel
